NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Used to build absolute guest/dashboard links (confirmation page + the
# owner email). Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional for local dev — if unset, lib/email.ts logs the email to the
# console instead of sending it. Get a key at https://resend.com.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Defaults to Resend's shared test sender (only deliverable to your own
# verified Resend account email until you verify a real sending domain).
RESEND_FROM_EMAIL=Après-midi <onboarding@resend.dev>

# Whish Pay credentials (from Whish's onboarding email). WHISH_BASE_URL is
# optional — defaults to the sandbox API unless NODE_ENV=production.
WHISH_CHANNEL=xxxxxxxx
WHISH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHISH_WEBSITE_URL=your-deployed-domain.vercel.app
